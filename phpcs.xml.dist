<?xml version="1.0"?>
<ruleset name="a11yfy">
	<description>WordPress-Extra ruleset for the a11yfy plugin (§13.9 CI gate).</description>

	<file>.</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>vendor-dev/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>js/*</exclude-pattern>
	<exclude-pattern>assets/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>
	<!-- Generated staging trees: copies of the sources checked above. Locally
	     they linger between builds and would double every finding. -->
	<exclude-pattern>dist/*</exclude-pattern>
	<exclude-pattern>tests/*</exclude-pattern>

	<arg value="ps"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>

	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="7.4-"/>

	<!-- CI gate: fail on errors only — remaining warnings are deliberate
	     patterns (silenced fs-ops with rollback, GET display params). -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<rule ref="WordPress-Extra">
		<!-- Repo layout is flat includes/ with class-*.php names; no PSR-4. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="a11yfy-pdf-accessibility-checker-fixer"/>
			</property>
		</properties>
	</rule>
</ruleset>
