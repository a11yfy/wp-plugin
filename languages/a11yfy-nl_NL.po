msgstr "Beheerdersmelding + e-mail wanneer het saldo onder dit bedrag daalt. 0 = uitgeschakeld."

#: includes/admin/views/settings.php:114
msgid "Saving strategy"
msgstr "Spaarstrategie"

#: includes/admin/views/settings.php:119
