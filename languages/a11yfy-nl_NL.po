msgstr "Bewaar de bewerkte PDF-bestanden (aanbevolen — het is immers uw inhoud)."

#: includes/admin/views/settings.php:149
msgid "Restore the original files from backup."
msgstr "Herstel de originele bestanden vanuit de back-up."

#: includes/admin/views/settings.php:156
msgid "Save settings"
msgstr "Instellingen opslaan"

