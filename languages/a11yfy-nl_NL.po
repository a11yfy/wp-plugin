msgstr "dezelfde URL, waarbij het origineel als back-up wordt bewaard en met één klik kan worden hersteld."

#: includes/admin/views/settings.php:124
msgid "Conservative"
msgstr "Conservatief"

#: includes/admin/views/settings.php:125
msgid "the original file is never touched; links are swapped when pages render."
msgstr "het oorspronkelijke bestand wordt nooit gewijzigd; de links worden omgewisseld wanneer de pagina’s worden weergegeven."

#: includes/admin/views/settings.php:131
msgid "Notification email"
msgstr "Bevestigingsmail"

#: includes/admin/views/settings.php:136
