msgstr "Meldingen over onvoldoende krediet en mislukkingen. Leeg = e-mailadres van de sitebeheerder."

#: includes/admin/views/settings.php:140
msgid "On plugin deletion"
msgstr "Over het verwijderen van plug-ins"

#: includes/admin/views/settings.php:145
