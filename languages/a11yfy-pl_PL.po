msgstr "Powiadomienie administratora + wiadomość e-mail, gdy saldo spadnie poniżej tej wartości. 0 = wyłączone."

#: includes/admin/views/settings.php:114
msgid "Saving strategy"
msgstr "Strategia oszczędzania"

#: includes/admin/views/settings.php:119
msgid "Replace in place (recommended)"
msgstr "Wymiana na miejscu (zalecana)"

#: includes/admin/views/settings.php:120
msgid "same URL, original kept as a backup with one-click restore."
msgstr "ten sam adres URL, oryginał zachowany jako kopia zapasowa z możliwością przywrócenia jednym kliknięciem."

#: includes/admin/views/settings.php:124
msgid "Conservative"
msgstr "Konserwatywny"

