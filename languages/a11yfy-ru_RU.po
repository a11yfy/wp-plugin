msgid "Document not found"
msgstr "Документ не найден"

#: includes/admin/views/document.php:26
msgid "This link does not point to a PDF in the Media Library."
msgstr "Эта ссылка не ведет на файл PDF в медиабиблиотеке."

#: includes/admin/views/document.php:64
