msgstr "O mesmo URL, com o original guardado como cópia de segurança e recuperação com um clique."

#: includes/admin/views/settings.php:124
msgid "Conservative"
msgstr "Conservador"

#: includes/admin/views/settings.php:125
msgid "the original file is never touched; links are swapped when pages render."
msgstr "O ficheiro original nunca é alterado; as ligações são substituídas quando as páginas são apresentadas."

#: includes/admin/views/settings.php:131
msgid "Notification email"
msgstr "E-mail de notificação"

#: includes/admin/views/settings.php:136
