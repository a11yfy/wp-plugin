msgstr "Notificações de créditos baixos e de insucesso. Vazio = e-mail do administrador do site."

#: includes/admin/views/settings.php:140
msgid "On plugin deletion"
msgstr "Sobre a eliminação de plug-ins"

#: includes/admin/views/settings.php:145
