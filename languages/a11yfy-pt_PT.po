msgstr "Guarde os ficheiros PDF corrigidos (recomendado — são o seu conteúdo)."

#: includes/admin/views/settings.php:149
msgid "Restore the original files from backup."
msgstr "Recupere os ficheiros originais a partir da cópia de segurança."

#: includes/admin/views/settings.php:156
msgid "Save settings"
msgstr "Guardar definições"

