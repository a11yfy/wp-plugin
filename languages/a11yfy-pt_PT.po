msgstr "Aviso de administração + e-mail quando o saldo ficar abaixo deste valor. 0 = desativado."

#: includes/admin/views/settings.php:114
msgid "Saving strategy"
msgstr "Estratégia de poupança"

#: includes/admin/views/settings.php:119
