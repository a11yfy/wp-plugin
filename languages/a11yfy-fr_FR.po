msgstr "Vous n'êtes pas autorisé(e) à télécharger ce certificat."

#: includes/admin/class-a11yfy-admin.php:460
msgid "This document has no a11yfy certificate yet."
msgstr "Ce document ne dispose pas encore d'un certificat a11yfy."

