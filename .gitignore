# Build-time fetched vendors (bin/fetch-vendors.sh) — not committed.
/vendor/

# JS engine workspace
/js/node_modules/

# Built bundles (regenerated by js/build.mjs)
/assets/js/dist/

# Distribution artifacts
/build/
/*.zip

# Composer dev tooling (PHPCS/PHPUnit)
/vendor-dev/
/composer.lock

# wp-env / Playwright dev tooling
/.wp-env.override.json
/node_modules/
/test-results/
/playwright-report/
/.phpunit.result.cache
